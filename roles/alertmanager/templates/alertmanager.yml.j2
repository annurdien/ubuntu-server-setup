global:
  resolve_timeout: 5m

route:
  group_by: ['alertname']
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 1h
  receiver: 'email'

receivers:
  - name: 'email'
{% if alertmanager_smtp_enabled | default(false) %}
    email_configs:
      - to: '{{ alertmanager_receivers[0].email_configs[0].to }}'
        from: '{{ alertmanager_smtp_from }}'
        smarthost: '{{ alertmanager_smtp_smarthost }}'
        auth_username: '{{ alertmanager_smtp_auth_username }}'
        auth_password: '{{ alertmanager_smtp_auth_password }}'
{% endif %}

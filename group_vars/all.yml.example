---
# Example configuration file
# Copy this file to group_vars/all.yml and update with your settings
# WARNING: Do NOT commit group_vars/all.yml to version control

# ===========================
# System Configuration
# ===========================
timezone: "UTC"
ntp_enabled: true

# ===========================
# Admin User Configuration
# ===========================
admin_user:
  name: "admin"
  password: "{{ 'YourSecurePassword' | password_hash('sha512') }}"  # Change this!
  shell: "/bin/bash"
  groups: "sudo"
  ssh_key: "{{ lookup('file', 'files/ssh_keys/admin_id_ed25519.pub') }}"

# ===========================
# Application Users
# ===========================
# System users for running applications (no login)
app_users:
  - name: "webapp"
    comment: "Web Application User"
    system: true
    shell: "/usr/sbin/nologin"
  - name: "backend"
    comment: "Backend Service User"
    system: true
    shell: "/usr/sbin/nologin"

# ===========================
# SSH Configuration
# ===========================
ssh_port: 22
ssh_permit_root_login: "no"
ssh_password_authentication: "no"
ssh_pubkey_authentication: "yes"
ssh_challenge_response_authentication: "no"
ssh_use_pam: "yes"
ssh_x11_forwarding: "no"
ssh_max_auth_tries: 3
ssh_max_sessions: 10
ssh_client_alive_interval: 300
ssh_client_alive_count_max: 2
ssh_listen_address: "0.0.0.0"

# ===========================
# UFW Firewall Configuration
# ===========================
ufw_enabled: true
ufw_default_incoming_policy: "deny"
ufw_default_outgoing_policy: "allow"
ufw_logging: "on"

# SSH port (will be rate-limited)
ufw_ssh_rate_limit: true
ufw_ssh_rate_limit_per_second: 10
ufw_ssh_rate_limit_burst: 5

# Additional allowed ports
ufw_allowed_ports: []
  # - { port: 80, proto: tcp }
  # - { port: 443, proto: tcp }

# ===========================
# Fail2Ban Configuration
# ===========================
fail2ban_enabled: true
fail2ban_bantime: 3600          # 1 hour
fail2ban_findtime: 600           # 10 minutes
fail2ban_maxretry: 5
fail2ban_destemail: "admin@example.com"  # Change this!
fail2ban_sender: "fail2ban@{{ ansible_fqdn }}"
fail2ban_action: "%(action_)s"   # Use "%(action_mwl)s" for email notifications

# Custom jails
fail2ban_custom_jails: []
  # - name: "nginx-limit-req"
  #   port: "http,https"
  #   filter: "nginx-limit-req"
  #   logpath: "/var/log/nginx/error.log"

# ===========================
# Cloudflare Configuration
# ===========================
cloudflare_account_id: "your-account-id"              # Change this!
cloudflare_tunnel_token: "your-tunnel-token"          # Change this!
cloudflare_tunnel_name: "my-server-tunnel"
cloudflare_tunnel_id: "your-tunnel-id"                # Change this!

# Domain configuration
domain_name: "example.com"                            # Change this!

# Applications to expose through Cloudflare Tunnel
cloudflare_applications:
  - name: "ssh"
    service: "ssh://localhost:22"
    hostname: "ssh.{{ domain_name }}"
    public: false  # Requires Zero Trust authentication
  
  - name: "webapp"
    service: "http://localhost:3000"
    hostname: "app.{{ domain_name }}"
    public: false
  
  - name: "api"
    service: "http://localhost:8080"
    hostname: "api.{{ domain_name }}"
    public: false

# ===========================
# Backup Configuration
# ===========================
backup_enabled: true
backup_retention_days: 30
backup_directory: "/opt/backups"

# Remote backup (S3 or DigitalOcean Spaces)
backup_remote_enabled: false
backup_remote_type: "s3"  # or "digitalocean"
backup_remote_bucket: "my-backups"
backup_remote_endpoint: "https://nyc3.digitaloceanspaces.com"  # For DigitalOcean
backup_remote_access_key: "your-access-key"                     # Change this!
backup_remote_secret_key: "your-secret-key"                     # Change this!
backup_remote_region: "us-east-1"

# What to backup
backup_items:
  - "/etc/ssh/sshd_config"
  - "/etc/ufw"
  - "/etc/fail2ban"
  - "/etc/cloudflared"
  - "/etc/passwd"
  - "/etc/shadow"
  - "/etc/group"
  - "/etc/sudoers.d"

# ===========================
# Package Configuration
# ===========================
essential_packages:
  - curl
  - wget
  - git
  - vim
  - htop
  - net-tools
  - ufw
  - fail2ban
  - unattended-upgrades
  - apt-transport-https
  - ca-certificates
  - gnupg
  - lsb-release

# Unattended upgrades
unattended_upgrades_enabled: true
unattended_upgrades_auto_reboot: false
unattended_upgrades_auto_reboot_time: "03:00"
unattended_upgrades_email: ""  # Optional: email for upgrade notifications

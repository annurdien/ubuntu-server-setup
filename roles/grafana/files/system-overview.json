{
  "dashboard": {
    "title": "System Overview",
    "uid": "system-overview",
    "tags": [
      "overview"
    ],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "CPU Usage",
        "type": "gauge",
        "targets": [
          {
            "expr": "100 - (avg(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU"
          }
        ],
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 8,
          "h": 8
        }
      },
      {
        "id": 2,
        "title": "Memory Usage",
        "type": "gauge",
        "targets": [
          {
            "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
            "legendFormat": "Memory"
          }
        ],
        "gridPos": {
          "x": 8,
          "y": 0,
          "w": 8,
          "h": 8
        }
      },
      {
        "id": 3,
        "title": "Disk Usage",
        "type": "gauge",
        "targets": [
          {
            "expr": "max((1 - (node_filesystem_avail_bytes{fstype!=\"tmpfs\"} / node_filesystem_size_bytes{fstype!=\"tmpfs\"})) * 100)",
            "legendFormat": "Disk"
          }
        ],
        "gridPos": {
          "x": 16,
          "y": 0,
          "w": 8,
          "h": 8
        }
      },
      {
        "id": 4,
        "title": "System Load",
        "type": "graph",
        "targets": [
          {
            "expr": "node_load1",
            "legendFormat": "Load 1m"
          },
          {
            "expr": "node_load5",
            "legendFormat": "Load 5m"
          },
          {
            "expr": "node_load15",
            "legendFormat": "Load 15m"
          }
        ],
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 24,
          "h": 8
        }
      }
    ]
  }
}